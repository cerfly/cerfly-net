<!DOCTYPE html>
<html lang="zh-Hans">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ headTitle or title }}</title>
    <link rel="stylesheet" href="/css/style.css">
    <meta name="description" content="{{ description }}">
    <link rel="canonical" href="https://cerfly.net{{ page.url }}">
    <link rel="alternate" type="application/atom+xml" title="cerfly.net — Blog" href="/feed.xml">
    <link rel="alternate" type="application/atom+xml" title="cerfly.net — 中文博客" href="/zh/feed.xml">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    {% if noindex %}<meta name="robots" content="noindex">{% endif %}
    {% if not noindex %}
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ ogTitle or title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:url" content="https://cerfly.net{{ page.url }}">
    <meta property="og:image" content="https://cerfly.net/assets/og-image.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ twitterTitle or ogTitle or title }}">
    <meta name="twitter:description" content="{{ description }}">
    <meta name="twitter:image" content="https://cerfly.net/assets/og-image.png">
    {% endif %}
</head>
<body>
    <nav class="navbar">
        <a href="/zh/" class="logo">cerfly</a>
        <ul class="nav-links">
            <li><a href="/zh/" {% if nav == 'home' %}class="active"{% endif %}>首页</a></li>
            <li><a href="/zh/ai.html" {% if nav == 'ai' %}class="active"{% endif %}>AI</a></li>
            <li><a href="/zh/about.html" {% if nav == 'about' %}class="active"{% endif %}>关于</a></li>
            <li><a href="/zh/blog.html" {% if nav == 'blog' %}class="active"{% endif %}>博客</a></li>
            <li><a href="/zh/projects.html" {% if nav == 'projects' %}class="active"{% endif %}>项目</a></li>
            <li><a href="/zh/now.html" {% if nav == 'now' %}class="active"{% endif %}>现在</a></li>
            <li class="lang-switch"><a href="{{ enUrl }}">EN</a> <span>/</span> <a href="{{ zhUrl }}" class="active">中文</a></li>
            <li>
                <button class="theme-toggle" aria-label="切换主题">
                    <span class="icon-moon">&#9790;</span>
                    <span class="icon-sun">&#9728;</span>
                </button>
            </li>
        </ul>
    </nav>

    <main>
{{ content | safe }}
    </main>

    <footer>
        <div class="socials">
            <a href="https://github.com/cerfly" target="_blank" rel="noopener">GitHub</a>
            <a href="/feed.xml">RSS</a>
            <a href="mailto:hello@cerfly.net">Email</a>
        </div>
        <p>&copy; 2026 cerfly.net</p>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>